global_defs {
    script_user {{ ansible_user }} docker
    enable_script_security
    max_auto_priority 99
    vrrp_no_swap
    checker_no_swap
}

vrrp_script check_pihole_dns {
    script "/etc/keepalived/check_pihole.sh"
    interval {{ keepalived_track_script_interval | default(2) }}
    # Pi-hole dig + optional Unbound dig (each +time=1) need headroom.
    timeout {{ keepalived_track_script_timeout | default(8) }}
    fall {{ keepalived_track_script_fall | default(2) }}
    rise {{ keepalived_track_script_rise | default(2) }}
    {# weight != 0: failed checks adjust priority instead of FAULT.
       FAULT on the backup prevents VIP takeover when the master process stops
       (seen under lab dig flakes / Docker DNS). #}
    weight {{ keepalived_track_script_weight | default(-50) }}
}

{# IPv6 VIP is optional. Without one, skip the sync group: a one-member group
   makes keepalived ignore weighted track_scripts, so container-stop failover
   never fires. Vagrant is always IPv4-only. #}
{% if (pihole_vip_ipv6 | default('') | string | length) > 0 and not (vagrant_env | default(false) | bool) %}
vrrp_sync_group PIHOLE {
    group {
        PIHOLE-IPv4
        PIHOLE-IPv6
    }
    {# Non-vagrant: track on sync group so IPv4+IPv6 share health. #}
    track_script {
        check_pihole_dns
    }
}
{% endif %}

vrrp_instance PIHOLE-IPv4 {
    interface {{ keepalived_vrrp_interface | default(ansible_facts['default_ipv4']['interface']) }}
    state {{ keepalive_role }}
    virtual_router_id {{ keepalived_virtual_router_id | default(1) }}
    priority {{ priority }}
    advert_int 1
{# keepalived ignores preempt_delay with initial state MASTER and keepalived -t
   exits non-zero on the warning. In production a BACKUP preempt_delay would
   only delay taking the VIP from a MASTER whose health check failed (weight
   drops it below the BACKUP); failback damping comes from the IPv6 instance. #}
{% if keepalive_role != 'MASTER' and (vagrant_env | default(false) | bool) %}
    preempt_delay 5
{% endif %}
    {# Unicast VRRP — required on libvirt/KVM NAT bridges where multicast is unreliable.
       keepalived -t fails if unicast_src_ip is set with an empty peer list (single-node). #}
{% if keepalived_peer_list | default([]) %}
    unicast_src_ip {{ keepalived_vrrp_src_address | default(ansible_facts['default_ipv4']['address']) }}
    unicast_peer {
{% for peer in keepalived_peer_list %}
        {{ peer }}
{% endfor %}
    }
{% endif %}
{% if vagrant_env | default(false) | bool %}
    # Faster VIP visibility on bridged/NAT lab networks (VirtualBox + libvirt).
    garp_master_delay 1
    garp_master_repeat 5
    garp_master_refresh 10
{% endif %}
{% if (vagrant_env | default(false) | bool) or ((pihole_vip_ipv6 | default('') | string | length) == 0) %}
    {# Weighted track_script on the instance when there is no IPv6 sync group. #}
    track_script {
        check_pihole_dns
    }
{% endif %}

    virtual_ipaddress {
        {{ pihole_vip_ipv4 }}
    }
}

{% if (pihole_vip_ipv6 | default('') | string | length) > 0 and not (vagrant_env | default(false) | bool) %}
vrrp_instance PIHOLE-IPv6 {
    interface {{ keepalived_vrrp_interface | default((ansible_facts['default_ipv6'] | default({}))['interface'] | default(ansible_facts['default_ipv4']['interface'])) }}
    virtual_router_id {{ keepalived_virtual_router_id | default(1) }}
    priority {{ priority }}
    advert_int 1
{# No initial state, so this delay holds on the MASTER node and, through the
   sync group, damps failback of both VIPs after it recovers. #}
{% if keepalive_role == 'MASTER' %}
    preempt_delay 30
{% endif %}
    {#- No instance track_script: the PIHOLE sync group tracks check_pihole_dns
       for both instances, and keepalived rejects weighted instance tracking
       inside a sync group (keepalived -t exits non-zero). #}

    virtual_ipaddress {
        {{ pihole_vip_ipv6 }}
    }
}
{% endif %}
