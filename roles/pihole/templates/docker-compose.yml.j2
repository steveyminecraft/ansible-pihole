---
{% set _join_dns_net = (pihole_enable_unbound | default(true) | bool) and (not (pihole_use_host_network | default(false) | bool)) and (pihole_network_name is defined and pihole_network_name | string | length > 0) %}
{% set _join_proxy_net = (pihole_proxy_enabled | default(false) | bool) and (not (pihole_use_host_network | default(false) | bool)) %}
{% set _proxy_network = traefik_network_name | default('proxy') %}
{% if _join_dns_net or _join_proxy_net %}
networks:
{% if _join_dns_net %}
  {{ pihole_network_name }}:
    external: true
{% endif %}
{% if _join_proxy_net %}
  {{ _proxy_network }}:
    external: true
{% endif %}

{% endif %}
services:

  pihole:
    container_name: {{ pihole_container_name }}
    hostname: {{ inventory_hostname }}
    image: {{ pihole_image }}
    restart: unless-stopped
{% if pihole_use_host_network | default(false) | bool %}
    network_mode: host
{% endif %}
    environment:
{% for var, value in pihole_environment_variables.items() %}
      - {{ var }}={{ value }}
{% endfor %}
    volumes:
      - {{ pihole_dir_loc }}/etc/pihole:/etc/pihole
      - {{ pihole_dir_loc }}/etc/dnsmasq.d:/etc/dnsmasq.d
{% if pihole_container_cap_add | default([]) | length > 0 %}
    cap_add:
{% for cap in pihole_container_cap_add %}
      - {{ cap }}
{% endfor %}
{% endif %}
{% if pihole_rocky_network_debug | default(false) | bool %}
    privileged: true
    security_opt:
      - seccomp=unconfined
      - label=disable
{% endif %}
{% if pihole_docker_dns | default([]) | length > 0 %}
    dns:
{% for ns in pihole_docker_dns %}
      - {{ ns }}
{% endfor %}
{% endif %}
{% if _join_dns_net or _join_proxy_net %}
    networks:
{% if _join_dns_net %}
      - {{ pihole_network_name }}
{% endif %}
{% if _join_proxy_net %}
      - {{ _proxy_network }}
{% endif %}
{% endif %}
{% if (pihole_proxy_enabled | default(false) | bool) and (not (pihole_use_host_network | default(false) | bool)) %}
    labels:
      traefik.enable: "true"
      traefik.docker.network: "{{ _proxy_network }}"
      traefik.http.routers.{{ pihole_proxy_router_name | default('pihole') }}.rule: "{% filter trim %}{% include 'proxy-host-rule.j2' %}{% endfilter %}"
{% if traefik_tls_enabled | default(true) | bool %}
      traefik.http.routers.{{ pihole_proxy_router_name | default('pihole') }}.entrypoints: "websecure"
      traefik.http.routers.{{ pihole_proxy_router_name | default('pihole') }}.tls: "true"
{% if (traefik_tls_mode | default('dns01')) == 'dns01' %}
      traefik.http.routers.{{ pihole_proxy_router_name | default('pihole') }}.tls.certresolver: "{{ traefik_acme_resolver_name | default('letsencrypt') }}"
{% endif %}
{% else %}
      traefik.http.routers.{{ pihole_proxy_router_name | default('pihole') }}.entrypoints: "web"
{% endif %}
      traefik.http.services.{{ pihole_proxy_router_name | default('pihole') }}.loadbalancer.server.port: "{{ pihole_proxy_backend_port | default(80) }}"
{% endif %}
{% if not (pihole_use_host_network | default(false) | bool) %}
    ports:
      - "53:53/tcp"
      - "53:53/udp"
{% if not (pihole_proxy_enabled | default(false) | bool) %}
      - "{{ pihole_webport_http }}:80/tcp"
      - "{{ pihole_webport_https }}:443/tcp"
{% endif %}
{% if pihole_environment_variables.DHCP_ACTIVE | lower == 'true' %}
      - "67:67/udp"  # DHCP port
{% endif %}
{% endif %}
