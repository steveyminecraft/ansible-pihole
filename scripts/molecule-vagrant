#!/usr/bin/env bash
# Align Molecule inventory with the Vagrant provider (VirtualBox vs libvirt).
#
# Interactive (no args): pick a provider, see the env + molecule commands, optionally run tests.
# Pass-through: forwards to molecule after setting MOLECULE_VAGRANT_INVENTORY from
#   VAGRANT_DEFAULT_PROVIDER (same as before).
#
# Examples:
#   ./scripts/molecule-vagrant
#   ./scripts/molecule-vagrant test -s default
#   ./scripts/molecule-vagrant test -s debian
#   VAGRANT_DEFAULT_PROVIDER=libvirt ./scripts/molecule-vagrant test -s default
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"

kvm_hypervisor_loaded() {
  [[ -e /dev/kvm ]] || return 1
  grep -qE '^kvm(_amd|_intel)? ' /proc/modules 2>/dev/null
}

pick_vagrant_provider() {
  if [[ -n "${VAGRANT_DEFAULT_PROVIDER:-}" ]]; then
    return 0
  fi
  if kvm_hypervisor_loaded; then
    export VAGRANT_DEFAULT_PROVIDER=libvirt
    echo "Using libvirt: KVM is loaded, so VirtualBox cannot enable AMD-V/SVM (VERR_SVM_IN_USE)." >&2
  else
    export VAGRANT_DEFAULT_PROVIDER=virtualbox
  fi
}

refuse_virtualbox_when_kvm_busy() {
  case "${VAGRANT_DEFAULT_PROVIDER:-}" in
    virtualbox)
      if kvm_hypervisor_loaded; then
        echo "ERROR: VAGRANT_DEFAULT_PROVIDER=virtualbox but KVM is loaded." >&2
        echo "VirtualBox fails with VERR_SVM_IN_USE (AMD-V/SVM already in use)." >&2
        echo "Use libvirt instead:" >&2
        echo "  VAGRANT_DEFAULT_PROVIDER=libvirt $0" >&2
        echo "To force VirtualBox, stop libvirt guests and unload kvm_amd/kvm_intel first." >&2
        return 1
      fi
      ;;
  esac
  return 0
}

sync_inventory_from_provider() {
  case "${VAGRANT_DEFAULT_PROVIDER:-virtualbox}" in
    libvirt|kvm)
      export MOLECULE_VAGRANT_INVENTORY="${MOLECULE_VAGRANT_INVENTORY:-vagrant_libvirt.yml}"
      export MOLECULE_VAGRANT_NO_UNBOUND_INVENTORY="${MOLECULE_VAGRANT_NO_UNBOUND_INVENTORY:-vagrant_no_unbound_libvirt.yml}"
      ;;
    *)
      export MOLECULE_VAGRANT_INVENTORY="${MOLECULE_VAGRANT_INVENTORY:-vagrant.yml}"
      export MOLECULE_VAGRANT_NO_UNBOUND_INVENTORY="${MOLECULE_VAGRANT_NO_UNBOUND_INVENTORY:-vagrant_no_unbound.yml}"
      ;;
  esac
}

if [[ $# -gt 0 ]]; then
  pick_vagrant_provider
  refuse_virtualbox_when_kvm_busy
  sync_inventory_from_provider
  exec molecule "$@"
fi

echo "Molecule + Vagrant — pick a provider (inventory + VM network must match):"
echo "  1) VirtualBox  (inventory/vagrant.yml, 192.168.56.x)"
echo "  2) libvirt / KVM (inventory/vagrant_libvirt.yml, 192.168.121.x)"
if kvm_hypervisor_loaded; then
  echo "KVM is loaded; VirtualBox will fail with VERR_SVM_IN_USE. Prefer 2 (libvirt)."
fi
read -r -p "Choice [1-2]: " choice

case "$choice" in
  1)
    provider="virtualbox"
    inventory="vagrant.yml"
    export VAGRANT_DEFAULT_PROVIDER=virtualbox
    refuse_virtualbox_when_kvm_busy
    ;;
  2)
    provider="libvirt"
    inventory="vagrant_libvirt.yml"
    ;;
  *)
    echo "Invalid choice." >&2
    exit 1
    ;;
esac

echo ""
echo "From the repo root ($repo_root), run:"
echo ""
echo "  export VAGRANT_DEFAULT_PROVIDER=$provider"
echo "  export MOLECULE_VAGRANT_INVENTORY=$inventory"
echo "  cd \"$repo_root\""
echo "  molecule test -s default"
echo ""
echo "One line (same effect):"
echo ""
echo "  cd \"$repo_root\" && VAGRANT_DEFAULT_PROVIDER=$provider MOLECULE_VAGRANT_INVENTORY=$inventory molecule test -s default"
echo ""
echo "Using this helper instead of manual exports:"
echo ""
echo "  cd \"$repo_root\" && VAGRANT_DEFAULT_PROVIDER=$provider ./scripts/molecule-vagrant test -s default"
echo ""
echo "Debian (closer to Raspberry Pi OS): replace -s default with -s debian"
echo "Traefik on Debian: -s debian-traefik or -s debian-traefik-http"
echo ""

read -r -p "Run \`molecule test -s default\` now with this provider? [y/N] " run_now
case "${run_now,,}" in
  y|yes)
    cd "$repo_root"
    export VAGRANT_DEFAULT_PROVIDER="$provider"
    export MOLECULE_VAGRANT_INVENTORY="$inventory"
    exec molecule test -s default
    ;;
  *)
    exit 0
    ;;
esac
